---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
import { CONTACT_EMAIL, LINKEDIN_URL } from "../config";
const baseUrl = import.meta.env.BASE_URL;

const aiProjects = projects.filter((p) => p.category === "ai");
const highlights = ["monetta", "daviplata", "reconoser", "femsa"]
    .map((id) => projects.find((p) => p.id === id))
    .filter(Boolean);

const stats = [
    { value: "10+", label: "years building products" },
    { value: "1M+", label: "monthly users on apps I built" },
    { value: "85%", label: "less fraud with biometrics" },
    { value: "10", label: "engineers led as CTO" },
];

const pipeline = ["User", "Agent", "Tools", "RAG", "Answer"];

const logos = [
    { src: "davivienda.png", alt: "Davivienda" },
    { src: "daviplata.svg", alt: "Daviplata" },
    { src: "femsa.png", alt: "Femsa Salud" },
    { src: "cenco.png", alt: "Cencosud" },
    { src: "amaris.png", alt: "Amaris Consulting" },
    { src: "pagatodo.png", alt: "Banco PagaTodo" },
    { src: "summa.jpg", alt: "Summa – Grupo Argos" },
    { src: "monetta.png", alt: "Monetta" },
];
---

<BaseLayout sideBarActiveItemID="home">
    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-5 pb-16 pt-16 md:pt-24">
        <div class="grid items-center gap-12 md:grid-cols-[1fr_auto]">
            <div>
                <ul class="mb-8 flex flex-wrap items-center gap-2 text-xs font-medium" aria-label="Agent pipeline">
                    {pipeline.map((step, i) => (
                        <li class="flex items-center gap-2">
                            <span class:list={[
                                "rounded-full border px-3 py-1",
                                step === "Agent" ? "border-primary bg-primary text-primary-content" : "border-base-300 text-base-content/70",
                            ]}>{step}</span>
                            {i < pipeline.length - 1 && <span class="text-base-content/40" aria-hidden="true">→</span>}
                        </li>
                    ))}
                </ul>

                <p class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-primary">Jorge Castaño</p>
                <h1 class="text-4xl font-bold leading-[1.08] md:text-6xl">
                    AI Engineer &amp;<br />Senior Software Engineer
                </h1>
                <p class="mt-6 max-w-2xl text-lg leading-relaxed text-base-content/80">
                    I build LLM agents, RAG pipelines and the production software around them — on top of 10+ years
                    shipping fintech, mobile banking and enterprise products used by more than a million people in Latin America.
                </p>
                <div class="mt-8 flex flex-wrap gap-3">
                    <a href={`${baseUrl}projects`} class="btn btn-primary">See my work</a>
                    <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-outline">Get in touch</a>
                    <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">LinkedIn ↗</a>
                </div>
                <p class="mt-6 text-sm text-base-content/60">Cali, Colombia · Open to remote roles and relocation</p>
            </div>

            <img
                src={`${baseUrl}profile.webp`}
                alt="Portrait of Jorge Castaño"
                width="288"
                height="288"
                class="mx-auto h-56 w-56 rounded-full object-cover ring-2 ring-primary/60 ring-offset-8 ring-offset-base-100 md:h-72 md:w-72"
            />
        </div>

        <ul class="mt-16 grid grid-cols-2 gap-4 md:grid-cols-4">
            {stats.map((s) => (
                <li class="rounded-2xl border border-base-300 bg-base-200 p-5">
                    <p class="font-display text-3xl font-semibold text-primary">{s.value}</p>
                    <p class="mt-1 text-sm text-base-content/70">{s.label}</p>
                </li>
            ))}
        </ul>
    </section>

    <!-- AI Engineering -->
    <section class="mx-auto max-w-6xl px-5 py-16" aria-labelledby="ai-title">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Now</p>
        <h2 id="ai-title" class="mt-2 text-3xl font-bold md:text-4xl">AI engineering in production</h2>
        <p class="mt-4 max-w-3xl text-base-content/80">
            Multi-agent orchestration, tool calling, RAG and guardrails — built with the same engineering discipline
            I applied for a decade in regulated, high-traffic fintech systems.
        </p>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
            {aiProjects.map((p) => <ProjectCard project={p} />)}
        </div>
    </section>

    <!-- Track record -->
    <section class="mx-auto max-w-6xl px-5 py-16" aria-labelledby="track-title">
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Track record</p>
        <h2 id="track-title" class="mt-2 text-3xl font-bold md:text-4xl">Fintech, mobile and enterprise at scale</h2>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
            {highlights.map((p) => <ProjectCard project={p!} />)}
        </div>
        <div class="mt-10 flex flex-wrap gap-3">
            <a href={`${baseUrl}projects`} class="btn btn-primary">All projects</a>
            <a href={`${baseUrl}cv`} class="btn btn-outline">Full experience</a>
        </div>
    </section>

    <!-- Logos -->
    <section class="mx-auto max-w-6xl px-5 py-12" aria-labelledby="logos-title">
        <h2 id="logos-title" class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-base-content/60">
            Companies I have built for
        </h2>
        <ul class="mt-8 grid grid-cols-2 items-center gap-4 sm:grid-cols-4">
            {logos.map((l) => (
                <li class="flex h-20 items-center justify-center rounded-xl bg-white/95 p-4">
                    <img src={`${baseUrl}${l.src}`} alt={l.alt} loading="lazy" class="max-h-10 w-auto object-contain" />
                </li>
            ))}
        </ul>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-6xl px-5 py-16">
        <div class="rounded-3xl border border-primary/40 bg-base-200 p-8 text-center md:p-14">
            <h2 class="text-3xl font-bold md:text-4xl">Building something with AI?</h2>
            <p class="mx-auto mt-4 max-w-2xl text-base-content/80">
                I'm open to AI Engineer, Senior Software Engineer and Tech Lead roles — remote or with relocation.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-primary">Email me</a>
                <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline">Connect on LinkedIn</a>
            </div>
        </div>
    </section>
</BaseLayout>
