---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';

export interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
	lang?: string;
}
const baseUrl = import.meta.env.BASE_URL;
const { title, description, image = `${baseUrl}profile.webp`, ogType = 'website', lang = 'en' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0C0C0E" />
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Jorge Castaño" />

<!-- Open Graph / LinkedIn -->
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Jorge Castaño" />
<meta property="og:locale" content={lang === "es" ? "es_CO" : "en_US"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.url)} />

<!-- Structured data -->
<script type="application/ld+json" is:inline set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Jorge Castaño",
	"jobTitle": "Senior Software Engineer & AI Engineer",
	"url": "https://jorgecastano.dev",
	"address": { "@type": "PostalAddress", "addressLocality": "Cali", "addressCountry": "CO" },
	"sameAs": ["https://www.linkedin.com/in/castano-jorge/", "https://github.com/jorgekast18"],
	"knowsAbout": ["LLM agents", "Retrieval-Augmented Generation", "Software architecture", "Fintech", "React Native", "TypeScript", "Python"]
})} />
