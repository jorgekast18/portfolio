---
import { CONTACT_EMAIL, LINKEDIN_URL } from "../config";
const { active } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const links = [
  { id: "home", label: "Home", href: `${baseUrl}` },
  { id: "projects", label: "Projects", href: `${baseUrl}projects` },
  { id: "cv", label: "Experience", href: `${baseUrl}cv` },
  { id: "about", label: "About", href: `${baseUrl}about` },
];
---

<header class="sticky top-0 z-40 w-full border-b border-base-300/70 bg-base-100/85 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5" aria-label="Main">
    <a href={`${baseUrl}`} class="font-display text-lg font-semibold tracking-tight">
      Jorge Castaño<span class="text-primary">.</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={[
              "rounded-lg px-3 py-2 text-sm font-medium transition-colors hover:text-primary",
              active === l.id ? "text-primary" : "text-base-content/75",
            ]}
            aria-current={active === l.id ? "page" : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
      <li class="ml-2">
        <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-primary btn-sm">Contact</a>
      </li>
    </ul>

    <details class="dropdown dropdown-end md:hidden">
      <summary class="btn btn-ghost btn-square" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-5 w-5 stroke-current" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </summary>
      <ul class="menu dropdown-content z-50 mt-2 w-52 rounded-box border border-base-300 bg-base-200 p-2 shadow-xl">
        {links.map((l) => (
          <li><a href={l.href} class:list={[{ "text-primary": active === l.id }]}>{l.label}</a></li>
        ))}
        <li><a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li><a href={`mailto:${CONTACT_EMAIL}`} class="text-primary">Contact</a></li>
      </ul>
    </details>
  </nav>
</header>
