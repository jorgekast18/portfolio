---
import BaseLayout from "../layouts/BaseLayout.astro";
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found">
  <div class="mx-auto max-w-2xl px-5 py-32 text-center">
    <p class="font-display text-7xl font-bold text-primary">404</p>
    <h1 class="mt-4 text-2xl font-semibold">This page couldn't be found.</h1>
    <a class="btn btn-primary mt-8" href={`${baseUrl}`}>Back to home</a>
  </div>
</BaseLayout>
