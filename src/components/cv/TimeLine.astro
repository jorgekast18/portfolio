---
const { title, company, date, tags } = Astro.props;
---

<article class="relative pl-8 pb-10 last:pb-0">
    <div class="absolute left-0 top-2 h-full w-px bg-base-300" aria-hidden="true"></div>
    <div class="absolute left-0 top-2 -ml-[5px] h-[11px] w-[11px] rounded-full bg-primary" aria-hidden="true"></div>

    <div class="rounded-2xl border border-base-300 bg-base-200 p-6">
        <div class="mb-3 flex flex-col gap-1 md:flex-row md:items-start md:justify-between md:gap-4">
            <div>
                <h3 class="text-lg font-semibold text-base-content">{title}</h3>
                <p class="text-sm font-medium text-primary">{company}</p>
            </div>
            <p class="shrink-0 text-sm text-base-content/70">{date}</p>
        </div>

        <div class="space-y-2 text-sm leading-relaxed text-base-content/80">
            <slot />
        </div>

        {tags && tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2 border-t border-base-300 pt-4" aria-label="Tech stack">
                {tags.map((tag: string) => (
                    <li class="rounded-full border border-base-300 px-2.5 py-0.5 text-xs text-base-content/80">{tag}</li>
                ))}
            </ul>
        )}
    </div>
</article>
