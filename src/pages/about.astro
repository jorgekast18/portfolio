---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT_EMAIL, LINKEDIN_URL } from "../config";
const baseUrl = import.meta.env.BASE_URL;

const focus = [
    { title: "AI engineering", text: "LLM agents, multi-agent orchestration, tool calling and RAG — taken to production with evaluation, guardrails and clear AI usage policies." },
    { title: "Production architecture", text: "Microservices, hexagonal and clean architecture, CI/CD and infrastructure as code on AWS and GCP." },
    { title: "Mobile & full stack", text: "End-to-end delivery from the API and the database to the app in the store, with React Native, NestJS, Next.js and Python." },
    { title: "Technical leadership", text: "Building and mentoring cross-functional teams — up to 10 engineers as CTO — with Agile delivery and measurable quality." },
];

const principles = [
    { title: "Simple solutions to complex problems", text: "Complex systems don't need complex code. I favor designs others can understand, test and extend." },
    { title: "Measure what matters", text: "Performance, fraud, response times, defects: I like work that ends in a number someone cares about." },
    { title: "Teams over heroes", text: "Great products come from great teams. I invest in mentoring, reviews and shared standards." },
    { title: "Technology serves the business", text: "Every technical decision should move a product or business goal forward." },
];
---

<BaseLayout
    title="About"
    description="About Jorge Castaño: Senior Software Engineer and AI Engineer from Cali, Colombia, with 10+ years in fintech, mobile banking and enterprise software."
    sideBarActiveItemID="about"
>
    <div class="mx-auto max-w-5xl px-5 py-16">
        <section class="grid items-center gap-10 md:grid-cols-[auto_1fr]">
            <img
                src={`${baseUrl}profile.webp`}
                alt="Portrait of Jorge Castaño"
                width="224"
                height="224"
                class="mx-auto h-48 w-48 rounded-full object-cover ring-2 ring-primary/60 ring-offset-8 ring-offset-base-100 md:h-56 md:w-56"
            />
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">About</p>
                <h1 class="mt-2 text-4xl font-bold md:text-5xl">Hi, I'm Jorge.</h1>
                <p class="mt-5 text-lg leading-relaxed text-base-content/85">
                    I'm a Senior Software Engineer and AI Engineer from Cali, Colombia. For more than 10 years I've built
                    fintech, mobile banking and enterprise products — from geolocation tools used by over a million people
                    every month to a blockchain wallet I co-founded as CTO.
                </p>
                <p class="mt-4 text-lg leading-relaxed text-base-content/85">
                    Today I focus on AI engineering: designing agents, RAG pipelines and the production software around them.
                    I'm the founder of Veqya, an AI agent platform for small businesses, and I'm pursuing an M.Sc. in Computer
                    Engineering at Universidad de Granada.
                </p>
            </div>
        </section>

        <section class="mt-20" aria-labelledby="focus-title">
            <h2 id="focus-title" class="text-3xl font-bold">What I do</h2>
            <div class="mt-8 grid gap-5 md:grid-cols-2">
                {focus.map((f) => (
                    <div class="rounded-2xl border border-base-300 bg-base-200 p-6">
                        <h3 class="text-lg font-semibold">{f.title}</h3>
                        <p class="mt-2 text-base-content/80">{f.text}</p>
                    </div>
                ))}
            </div>
        </section>

        <section class="mt-20" aria-labelledby="principles-title">
            <h2 id="principles-title" class="text-3xl font-bold">How I work</h2>
            <ol class="mt-8 grid gap-5 md:grid-cols-2">
                {principles.map((p, i) => (
                    <li class="flex gap-4 rounded-2xl border border-base-300 bg-base-200 p-6">
                        <span class="font-display text-2xl font-semibold text-primary">0{i + 1}</span>
                        <div>
                            <h3 class="font-semibold">{p.title}</h3>
                            <p class="mt-1 text-base-content/80">{p.text}</p>
                        </div>
                    </li>
                ))}
            </ol>
        </section>

        <section class="mt-20 rounded-3xl border border-primary/40 bg-base-200 p-8 text-center md:p-12">
            <h2 class="text-3xl font-bold">Let's work together</h2>
            <p class="mx-auto mt-4 max-w-2xl text-base-content/80">
                Open to AI Engineer, Senior Software Engineer and Tech Lead roles — remote or with relocation.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a href={`mailto:${CONTACT_EMAIL}`} class="btn btn-primary">Email me</a>
                <a href={`${baseUrl}cv`} class="btn btn-outline">View my experience</a>
                <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">LinkedIn ↗</a>
            </div>
        </section>
    </div>
</BaseLayout>
