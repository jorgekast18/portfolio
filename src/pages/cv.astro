---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import { CONTACT_EMAIL, LINKEDIN_URL } from "../config";

const skills = [
    { group: "AI & LLMs", items: ["AI Agents", "Multi-agent orchestration", "Tool calling", "RAG", "Embeddings / pgvector", "Prompt engineering", "Guardrails & AI policies", "OpenAI API", "Google Gemini", "LangChain", "AWS Bedrock", "n8n"] },
    { group: "ML & Computer Vision", items: ["Deep learning", "Neural networks", "PyTorch", "OpenCV", "Facial recognition", "Liveness detection", "AWS Rekognition"] },
    { group: "Languages", items: ["Python", "TypeScript", "JavaScript", "Java", "C#", "Kotlin", "Swift", "Dart"] },
    { group: "Backend & Frontend", items: ["NestJS", "Node.js", "FastAPI", "Spring Boot", ".NET Core", "React", "Next.js", "React Native", "Flutter", "Angular"] },
    { group: "Cloud & DevOps", items: ["AWS", "GCP", "Azure", "Docker", "Kubernetes", "Terraform", "CI/CD", "GitHub Actions", "SonarQube"] },
    { group: "Architecture & Leadership", items: ["System design", "Hexagonal / Clean architecture", "Microservices", "Technical leadership", "Mentoring", "Agile / Scrum"] },
];
---

<BaseLayout
    title="Experience"
    description="Experience of Jorge Castaño: AI engineering, Tech Lead at Amaris Consulting, Co-Founder & CTO at Monetta, mobile banking for Davivienda, Daviplata and Banco PagaTodo."
    sideBarActiveItemID="cv"
>
    <div class="mx-auto max-w-4xl px-5 py-16">
        <header>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-primary">Experience</p>
            <h1 class="mt-2 text-4xl font-bold md:text-5xl">10+ years shipping products that scale</h1>
            <p class="mt-4 text-lg text-base-content/80">
                Senior Software Engineer and Tech Lead focused on AI engineering, with a background in fintech,
                mobile banking and enterprise platforms.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
                <a href={`mailto:${CONTACT_EMAIL}?subject=Resume%20request`} class="btn btn-primary btn-sm">Request my resume</a>
                <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm">LinkedIn ↗</a>
            </div>
        </header>

        <section class="mt-14" aria-labelledby="exp-title">
            <h2 id="exp-title" class="mb-8 border-b border-base-300 pb-3 text-2xl font-bold">Professional experience</h2>

            <TimeLineElement title="Founder & AI Engineer" company="Veqya" date="Jan 2026 – Present"
                tags={["Python", "LLMs", "AI Agents", "NestJS", "Next.js", "n8n", "PostgreSQL"]}>
                <ul class="list-disc space-y-1 pl-5">
                    <li>Building an AI agent platform that runs appointments, schedules and sales for small businesses (clinics, salons, sports venues).</li>
                    <li>Designed the multi-agent orchestration: agent harness, tool calling, AI usage policies, guardrails and customer segmentation.</li>
                </ul>
            </TimeLineElement>

            <TimeLineElement title="Tech Lead & Senior Software Engineer" company="Amaris Consulting" date="Sep 2024 – Present"
                tags={["TypeScript", "React Native", "NestJS", "LLMs", "GitHub Actions", "SonarQube"]}>
                <ul class="list-disc space-y-1 pl-5">
                    <li><strong class="text-base-content">Femsa Salud, Cruz Verde Chile (Apr 2026 – Present):</strong> built an LLM shopping assistant with tool calling (tested, pending launch), a NestJS Backend for Frontend and SonarQube quality gates in CI/CD.</li>
                    <li><strong class="text-base-content">Cencosud (May 2025 – Feb 2026):</strong> ran the organization-wide SonarQube platform, onboarding 3,500+ repositories and advising 20+ teams.</li>
                    <li><strong class="text-base-content">Femsa Salud, Yza Mexico (Dec 2024 – May 2025):</strong> improved app performance by 30% and shipped 5+ core features for 100K+ users.</li>
                    <li><strong class="text-base-content">Summa, Grupo Argos (Sep – Dec 2024):</strong> led 4 engineers and cut response times by about 45%.</li>
                </ul>
            </TimeLineElement>

            <TimeLineElement title="React Native Lead" company="Banco PagaTodo (Mexico, remote)" date="Feb 2023 – Feb 2024"
                tags={["React Native", "Redux", "Spring Boot", "Azure DevOps"]}>
                <ul class="list-disc space-y-1 pl-5">
                    <li>Led a team of 4 engineers in Colombia on the ObtenMas and PagaTodo mobile banking apps.</li>
                    <li>Upgraded React Native and applied Clean Architecture: 45% smaller app, 75% better performance test results.</li>
                </ul>
            </TimeLineElement>

            <TimeLineElement title="Lecturer, Systems Engineering (part-time)" company="Corporación Universitaria Autónoma de Nariño" date="Feb 2022 – May 2023">
                <p>Taught Data Structures, Programming Fundamentals, Databases, Software Engineering I &amp; II and Programming Languages.</p>
            </TimeLineElement>

            <TimeLineElement title="Co-Founder & CTO" company="Monetta" date="Jun 2021 – Feb 2023"
                tags={["TypeScript", "NestJS", "React Native", "Next.js", "FastAPI", "AWS", "Polygon"]}>
                <ul class="list-disc space-y-1 pl-5">
                    <li>Built the engineering department from scratch: 6 developers, 2 QA engineers and 2 DevOps engineers.</li>
                    <li>Delivered 2 mobile apps and 1 CMS; closed 6 strategic partnerships that added 3 product modules for 1,000+ users.</li>
                    <li>Wrote 20+ engineering policies and introduced Agile practices: +45% throughput, −25% defects.</li>
                </ul>
            </TimeLineElement>

            <TimeLineElement title="Technical Lead (freelance)" company="Cetoco — clients Davivienda, Daviplata, OWO" date="2019 – 2024"
                tags={["JavaScript", "Node.js", "AngularJS", "Python", "FastAPI", "Flutter", "Google Maps API"]}>
                <ul class="list-disc space-y-1 pl-5">
                    <li>Built Daviplata's official geolocation map in 8 months, then owned support and features: 15K+ points, 40% faster load, 1M+ monthly users.</li>
                    <li>Built Davivienda's branch and ATM locator (2,500+ points, 99.9% uptime) and a geolocation CMS serving 2M+ queries per month.</li>
                    <li>OWO (Oct 2021 – Oct 2022): led 3 developers; integrated 2 payment gateways and 5 providers.</li>
                </ul>
            </TimeLineElement>

            <TimeLineElement title="Mobile Technical Lead" company="reconoSER ID" date="Oct 2019 – Nov 2021"
                tags={["Kotlin", "Swift", "C# / .NET Core", "Flutter", "Biometrics"]}>
                <ul class="list-disc space-y-1 pl-5">
                    <li>Led 5 developers and 2 QA engineers building the mobile identity-verification SDK sold to enterprise clients.</li>
                    <li>Anti-spoofing (liveness detection) project that helped clients cut e-commerce fraud by up to 85%.</li>
                </ul>
            </TimeLineElement>

            <TimeLineElement title="Lead Backend Engineer" company="SuRed" date="Feb 2019 – Oct 2019"
                tags={["Java", "Spring Boot", "Node.js", "AWS", "PostgreSQL"]}>
                <ul class="list-disc space-y-1 pl-5">
                    <li>Led a new payment gateway for 10,000+ customers, cutting processing time by 40%.</li>
                    <li>Introduced hexagonal architecture and clean code, reducing duplicate code by 25%.</li>
                </ul>
            </TimeLineElement>

            <TimeLineElement title="Frontend Lead" company="Adatec" date="Nov 2016 – Feb 2019"
                tags={["JavaScript", "Angular", "Sencha Touch", "Django", ".NET Core"]}>
                <ul class="list-disc space-y-1 pl-5">
                    <li>Migrated desktop sales software to a web platform, increasing customer access by 85%.</li>
                    <li>Delivered 5 modules for the R-Sales field-sales app used by 200+ field workers.</li>
                </ul>
            </TimeLineElement>
        </section>

        <section class="mt-16" aria-labelledby="edu-title">
            <h2 id="edu-title" class="mb-8 border-b border-base-300 pb-3 text-2xl font-bold">Education</h2>
            <TimeLineElement title="M.Sc. in Computer Engineering" company="Universidad de Granada, Spain" date="Sep 2025 – Present">
                <p>Deep learning and machine learning projects, distributed systems and software architecture.</p>
            </TimeLineElement>
            <TimeLineElement title="B.Sc. in Systems Engineering" company="Universidad del Valle, Colombia" date="2011 – 2017">
                <p>Software development, algorithms and system design.</p>
            </TimeLineElement>
            <TimeLineElement title="Certificate in Information Security" company="Universidad ICESI, Colombia" date="2018" />
        </section>

        <section class="mt-16" aria-labelledby="skills-title">
            <h2 id="skills-title" class="mb-8 border-b border-base-300 pb-3 text-2xl font-bold">Skills</h2>
            <div class="grid gap-8 md:grid-cols-2">
                {skills.map((s) => (
                    <div>
                        <h3 class="mb-3 text-base font-semibold">{s.group}</h3>
                        <ul class="flex flex-wrap gap-2">
                            {s.items.map((i) => (
                                <li class="rounded-full border border-base-300 px-3 py-1 text-sm text-base-content/85">{i}</li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
            <p class="mt-8 text-sm text-base-content/70">Languages: Spanish (native) · English (intermediate, B1)</p>
        </section>
    </div>
</BaseLayout>
